PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/helpdesk
# Required. Generate with: openssl rand -hex 32
AUTH_SECRET=
# Set only when the app is behind a reverse proxy. Use the number of proxy hops.
# TRUST_PROXY=1
# Set false when the React app is hosted separately (for example on Vercel).
# SERVE_CLIENT=true
# Comma-separated origins, only needed when the client is on a different origin.
# CLIENT_ORIGIN=https://helpdesk.vercel.app
# One-time first-run admin bootstrap. Remove both after the admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Set true only for a demo install; never on a public production database.
SEED_DEMO=false
